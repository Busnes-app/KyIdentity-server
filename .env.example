# Example .env file for KyIdentity Server. Copy to .env and adjust values.

# The network KyIdentity and the proxy in front of it share, and KyIdentity's fixed address on it.
# Defaults: kypost-net, 10.89.0.0/24, 10.89.0.2.
# Prefer addressing the container by name in your proxy (http://KyIdentity-Server:5867).
KYPOST_NETWORK=kypost-net
KYPOST_SUBNET=10.89.0.0/24
KYIDENTITY_IP=10.89.0.2

# Interface the compose file publishes port 5867 on:
#   KYIDENTITY_BIND=127.0.0.1     # proxy on this host, or proxy on kypost-net
#   KYIDENTITY_BIND=192.168.1.50  # only the interface the proxy talks to
#   KYIDENTITY_BIND=0.0.0.0       # publish on all interfaces
KYIDENTITY_BIND=127.0.0.1

# Canonical public URL used in OpenID Connect discovery and OAuth tokens
# Set this to your public Cloudflare Tunnel HTTPS address in production:
#   KYIDENTITY_ISSUER_URL=https://auth.yourdomain.com
KYIDENTITY_ISSUER_URL=http://localhost:5867

# Port to listen on inside container
KYIDENTITY_PORT=5867

# Which peers' X-Forwarded-For/X-Forwarded-Proto/X-Real-IP/CF-Connecting-IP headers the
# server will believe. Comma-separated CIDRs or bare IPs. DEFAULT: empty (trust nobody).
#
# Set this to your reverse proxy's address and NOTHING else. Every host inside a range you
# list here can forge its own client IP, which defeats the login rate limiter, the MFA
# attempt limiter, and the IP recorded in your audit log. A whole private range means
# every laptop, phone, and IoT device on that network can do so.
#
#   TRUSTED_PROXY_CIDRS=10.89.0.1        # the proxy on kypost-net. Correct.
#   TRUSTED_PROXY_CIDRS=10.0.0.0/8       # 16 million trusted spoofers. Wrong.
#
# Leave unset if nothing sits in front of KyIdentity.
# TRUSTED_PROXY_CIDRS=10.89.0.1

# Optional: force the Secure flag on session cookies. Set this when a proxy terminates TLS
# but does not forward X-Forwarded-Proto. Without it, cookies may be issued without Secure.
# KYIDENTITY_SECURE_COOKIES=true

# Browser sessions expire after 24 hours, or after 30 minutes without activity. Values
# use Go durations (for example: 8h, 30m). The idle limit cannot exceed the absolute one.
# KYIDENTITY_SESSION_TTL=24h
# KYIDENTITY_SESSION_IDLE_TTL=30m

# Required in production: 32-byte hex keys. Generate each with: openssl rand -hex 32
# If unset, KyIdentity generates them into the data directory on first run and reuses them.
# A malformed value is a startup error, never a silently weakened key.
# KYIDENTITY_SECRET_KEY=
# KYIDENTITY_ENCRYPTION_KEY=

# Optional native mobile push relays. URLs must be HTTPS Cloudflare Worker URLs.
# If a URL is set and the matching key is unset, KyIdentity calls /register once and
# saves the returned key under the data directory. Leave keys unset here unless you
# are pasting a key into your private .env file.
# PUSH_RELAY_URL=https://kysecurity-mobile-push-fcm.<account>.workers.dev
# PUSH_RELAY_KEY=
# APNS_RELAY_URL=https://kysecurity-mobile-push-apns.<account>.workers.dev
# APNS_RELAY_KEY=

# Optional: Seed initial administrator credentials on first run
BOOTSTRAP_ADMIN_USER=admin
# BOOTSTRAP_ADMIN_PASS=YourStrongPassword123!

# Allow paired systems (KyPost, KyDNS, ...) to register callback URLs on loopback or
# private ranges. Required when every service shares a container network such as
# kypost-net. Leave unset on a public deployment: an attacker who redeems a pairing token
# could otherwise point KyIdentity at internal addresses.
# KYIDENTITY_ALLOW_PRIVATE_CALLBACKS=true

# Source install: uncomment so every `docker compose` command builds from this checkout
# instead of pulling the published image (see docker-compose.build.yml).
#COMPOSE_FILE=docker-compose.yml:docker-compose.build.yml
# LAN resolver, only with docker-compose.lan-dns.yml in COMPOSE_FILE (see that file's header).
#KYIDENTITY_DNS=192.168.1.1
# Run one verified digest instead of the rolling tag (recipe in docker-compose.yml).
#KYIDENTITY_IMAGE=ghcr.io/busness-app/kyidentity-server@sha256:<verified digest>
